[Unit]
Description=Lite-Recorder multi-camera recording web app
After=network.target lite-recorder-ap.service
Wants=lite-recorder-ap.service

[Service]
Type=simple
User=lite-recorder
Group=lite-recorder
SupplementaryGroups=video
EnvironmentFile=-/etc/lite-recorder/app.env
WorkingDirectory=/opt/lite-recorder
ExecStart=/opt/lite-recorder/venv/bin/python -m lite_recorder
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
