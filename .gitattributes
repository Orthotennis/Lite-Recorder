# Everything in this repo runs on Linux (Raspberry Pi / WSL), so keep LF line
# endings on checkout even when Git for Windows has core.autocrlf=true.
# A CRLF shell script fails with e.g. ": invalid option name: set: pipefail".
* text=auto eol=lf
*.sh text eol=lf
*.service text eol=lf
*.template text eol=lf
*.example text eol=lf
