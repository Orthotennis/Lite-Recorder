# Lite-Recorder access-point configuration.
# Copy to /etc/lite-recorder/ap.env and adjust for your hardware.

# The Wi-Fi interface that will host the access point.
#   - Rock 5B+ onboard Wi-Fi is commonly "wlan0", but some onboard RK3588
#     chipsets have weak/unsupported AP-mode driver support. If hostapd
#     fails to start, or `iw list` doesn't show "AP" under "Supported
#     interface modes", use a known-good USB Wi-Fi dongle instead.
#   - A USB dongle typically enumerates as "wlan1" (or "wlxAABBCCDDEEFF"
#     if predictable naming is enabled). Find yours with:
#       ls /sys/class/net
#       iw dev
WIFI_IFACE=wlan0

# Network shown to phones/laptops connecting to the recorder.
SSID=LiteRecorder
PASSPHRASE=change-me-please

# 2.4 GHz channel 1-11 is the safest default for broad client compatibility.
# If you need 5 GHz, verify hardware support with `iw list`.
CHANNEL=6

# Wireless regulatory domain (2-letter ISO code, e.g. US, GB, DE).
# Required for legal channel/power selection - hostapd will refuse
# certain channels/power levels without a correct COUNTRY.
COUNTRY=US

# Static IP the SBC assigns itself on the AP interface. This is the
# address the control UI is reached at, e.g. http://192.168.4.1
AP_ADDR=192.168.4.1
AP_NETMASK=255.255.255.0
AP_DHCP_RANGE_START=192.168.4.10
AP_DHCP_RANGE_END=192.168.4.100
