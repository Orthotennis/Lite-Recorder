# Copy to /etc/lite-recorder/app.env and adjust as needed. Read by
# systemd/lite-recorder.service via EnvironmentFile.

# Where recordings are written. Point this at an external SSD mount
# (e.g. /mnt/ssd/recordings) if the onboard eMMC/SD is too small.
LITE_RECORDER_RECORDINGS_ROOT=/var/lib/lite-recorder/recordings

# App state (camera labels/settings, thumbnails cache).
LITE_RECORDER_STATE_DIR=/var/lib/lite-recorder

LITE_RECORDER_HOST=0.0.0.0
LITE_RECORDER_PORT=80

# Which cameras to use:
#   real     - only real V4L2 cameras (recommended on the board: never
#              silently records synthetic video if a camera drops out)
#   auto     - real cameras when present, simulated ones as a reported
#              fallback (the default, and what scripts/run-local.sh uses)
#   simulate - synthetic test patterns only, for testing without cameras
LITE_RECORDER_CAMERA_MODE=real

# Legacy equivalent of LITE_RECORDER_CAMERA_MODE=simulate.
#LITE_RECORDER_SIMULATE=1

# Force a specific encoder instead of auto-detecting (e.g. to debug the
# degraded-encoder banner, or pin to libx264 if h264_rkmpp misbehaves).
#LITE_RECORDER_FORCE_ENCODER=libx264
